. * LaTeX
. file write cnt "\toprule" _n " & \multicolumn{2}{c}{Panel A: Binary DID, 2009
>  drought}\\*" _n "\cmidrule(lr){2-3}" _n " & Control & Treated\\*" _n "\midru
> le" _n

. foreach o in haz waz bmiz {
  2.     local O = upper("`o'")
  3.     local space ""
