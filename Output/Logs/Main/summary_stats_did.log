. if _rc ssc install ftools

. capture which require

. if _rc ssc install require

. foreach o in haz waz bmiz {
  2.     quietly reghdfe `o' treat_post drought2005_post drought2006_post droug
> ht2007_post drought2008_post dwell_electricity_02_post dwell_floor_good_02_po
> st dwell_roof_good_02_post dwell_ventilation_good_02_post rooms_per_person_02
> _post ln_pc_expend_month_02_post rural_02_post child_male_05_post mother_heig
> ht_cm_05_post mother_edu_years_05_post mother_age_at_birth_05_post mother_emp
> loyed_05_post fully_vaccinated_05_post if s_`o' == 1, absorb(pid_link_canonic
> al int_ym) vce(cluster cvegeo05)
  3.         * Picking model 3 sample for model 3 summary table
.     gen m3s_`o' = e(sample)
  4.     quietly distinct pid_link_canonical if e(sample)
  5.         * Here we add some formatting for these 4 lines below
.         * m3_ = children in Model 3
.     local m3_`o' : display %9.0fc r(ndistinct)
  6.     local m3_`o' = strtrim("`m3_`o''")
  7.     * spi_ = children in the SPI sample
.     quietly count if reg_`o' == 1 & year == 2005 & rain_z2009 < 1
  8.     local spi_`o' : display %9.0fc r(N)
  9.     local spi_`o' = strtrim("`spi_`o''")
 10. }

