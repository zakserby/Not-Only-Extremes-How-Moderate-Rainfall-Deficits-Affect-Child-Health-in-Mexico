. do "$root/Scripts/Statistics/Summary Stats DID.do"

. *******************************************************************
. * Summary statistics for the 2009 drought DID
. * Project: MS Thesis
. *******************************************************************
. 
. clear all

. set more off

. 
. *******************************************************************
. * Directories
. *******************************************************************
. * The root folder is set once in 00_Master.do. If this file is run on its own
> , the root is found by going up from Stata's working folder until the folder 
> that has Scripts/00_Master.do
. if "$root" == "" {
.     local r = subinstr("`c(pwd)'", "\", "/", .)
.     while "`r'" != "" & !fileexists("`r'/Scripts/00_Master.do") {
  2.         local r = substr("`r'", 1, strrpos("`r'", "/") - 1)
  3.     }
.     global root "`r'"
. }

. global raw_mxfls     "$root/Data/Raw/MxFLS"

. global raw_who       "$root/Data/Raw/WHO_reference"

. global clean_mxfls   "$root/Data/Cleaned/MxFLS"

. global clean_who     "$root/Data/Cleaned/WHO_zscores"

. global clean_rain    "$root/Data/Cleaned/Rainfall"

. global clean_banxico "$root/Data/Cleaned/Banxico"

. global out_sumstats  "$root/Output/Tables"

. global out_regs      "$root/Output/Regression_Estimates" 

. global out_logs      "$root/Output/Logs"

. global out_figs      "$root/Output/Figures" 

. 
. * Create the folders this project writes to (capture skips quietly if a folde
> r already exists)
. foreach d in "$root/Data" "$root/Data/Cleaned" "$clean_mxfls" "$clean_who" "$
> clean_rain" "$root/Output" "$out_sumstats" "$out_regs" "$out_logs" {
  2.     capture mkdir "`d'"
  3. }

. * This includes writing to Main and Appendix subfolders, same as 00_Master.do
. foreach d in "$out_sumstats" "$out_regs" "$out_logs" {
  2.     foreach s in Main Appendix {
  3.         capture mkdir "`d'/`s'"
  4.     }
  5. }

. * 
. * Tables and figures go to the folder of where they are placed, Main (paper),
>  Appendix (appendix in the paper) or Online_Appendix
. * The dose summary table is in the main text, the BMIZ balance table and over
> lap figure, the attrition tests and the Model 3 summary table in the appendix
> , and the sample size, sample attrition, HAZ and WAZ balance tables and overl
> ap figures in the online appendix
. capture mkdir "$out_sumstats/Online_Appendix"

. capture mkdir "$out_figs"

. foreach s in Main Appendix Online_Appendix {
  2.     capture mkdir "$out_figs/`s'"
  3. }

. 
. *******************************************************************
. * Some preliminaries
. *******************************************************************
. 
. capture which estpost

. if _rc ssc install estout

. capture which distinct

. if _rc ssc install distinct

. 
