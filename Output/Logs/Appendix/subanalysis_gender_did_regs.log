. 
. * Triple difference event study, same as DID_Regs.do but with child sex
. * NOTE: This figure is not being in the paper or online appendix used but the
>  pretrend is in a table in the online appendix
. gen lead_2_male = child_male_05 * (year == 2002)
(25,441 missing values generated)

. gen lag_0_male  = child_male_05 * (year == 2009)
(25,441 missing values generated)

. gen lead_2_dddm = treat2009 * child_male_05 * (year == 2002)
(25,453 missing values generated)

. gen lag_0_dddm  = treat2009 * child_male_05 * (year == 2009)
(25,453 missing values generated)

. 
. foreach v in haz waz bmiz {
  2.     reghdfe `v' lead_2_dddm lag_0_dddm lead_2_treat lag_0_treat lead_2_mal
> e lag_0_male $es_controls if e_`v' == 1 & mddd_`v' == 1, absorb($FE_month) vc
> e(cluster cvegeo05)
  3.     * Pre-trend test for the DDD. The lead should be about 0
.     test lead_2_dddm
  4.     lincom lag_0_treat + lag_0_dddm
  5. 
.     preserve
  6.     postfile handle int etime double b se lb ub using "$out_regs/Appendix/
> es_ddd_sex_`v'.dta", replace
  7.     post handle (-2) (_b[lead_2_dddm]) (_se[lead_2_dddm]) (_b[lead_2_dddm]
>  - 1.96*_se[lead_2_dddm]) (_b[lead_2_dddm] + 1.96*_se[lead_2_dddm])
  8.     post handle (-1) (0) (0) (0) (0)
  9.     post handle (0) (_b[lag_0_dddm]) (_se[lag_0_dddm]) (_b[lag_0_dddm] - 1
> .96*_se[lag_0_dddm]) (_b[lag_0_dddm] + 1.96*_se[lag_0_dddm])
 10.     postclose handle
 11. 
.     use "$out_regs/Appendix/es_ddd_sex_`v'.dta", clear
 12.     sort etime
 13.     twoway ///
>         (rcap ub lb etime, lcolor(black)) ///
>         (scatter b etime, mcolor(blue) msymbol(O)), ///
>         xlabel(-2 "2002" -1 "2005 (ref)" 0 "2009") ///
>         xline(-1, lpattern(dash) lcolor(red)) ///
>         yline(0, lpattern(dash) lcolor(black)) ///
>         xtitle("Event time (wave)") ytitle("Coefficient") ///
>         title("DDD event study (drought x male): `v'") legend(off)
 14.     graph export "$out_figs/Online_Appendix/event_study_ddd_sex_`v'.png", 
> replace
 15.     restore
 16. }
