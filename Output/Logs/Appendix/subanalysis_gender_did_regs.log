
. local own_log = (_rc == 0)

. 
. *******************************************************************
. * Load DID analysis data
. *******************************************************************
. 
. * Loading in data
. use "$clean_mxfls/mxfls_did_analysis.dta", clear
(ENNVIH-3 Libro s_sa)

. 
. label variable child_male_05 "Child is male (2005 roster), 1=Male 0=Female"

. 
. * Event study leads and lags: 2002 = -2 is the lead, 2005 = -1 is the referen
> ce, 2009 = 0
. gen lead_2_treat = treat2009 * (year == 2002)
(25,453 missing values generated)

. gen lag_0_treat  = treat2009 * (year == 2009)
(25,453 missing values generated)

. gen lead_2_remit = remittance_hh_02 * (year == 2002)
(44,004 missing values generated)

. gen lag_0_remit  = remittance_hh_02 * (year == 2009)
(44,004 missing values generated)

. gen lead_2_ddd   = treat2009 * remittance_hh_02 * (year == 2002)
(44,016 missing values generated)

. gen lag_0_ddd    = treat2009 * remittance_hh_02 * (year == 2009)
(44,016 missing values generated)

. 
. * IMPORTANT NOTE IS THIS IS JUST A ROBUSTNESS CHECK, IT DROPS THE SAMPLE SIZE
>  SIGNIFICANTLY 
. 
. * We run the same event study as above but only children measured in all thre
> e waves with the outcome nonmissing in each. This way the 2002 lead and the 2
> 009 coefficient come from the same children
. foreach v in haz waz bmiz {
  2.     bysort pid_link_canonical: egen n3_`v' = total(e_`v' == 1 & !missing(`
> v'))
  3.     gen e_`v'_all3 = (e_`v' == 1 & !missing(`v') & n3_`v' == 3)
  4. }

. 
. *******************************************************************
. * Fixed Effects & Controls
. *******************************************************************
. 
. * Same as DID_Regs do file, except child_male_05_post is taken out of control
> s05 because sex does not vary within a subsample
. global FE_month "pid_link_canonical int_ym"

. global did_controls "drought2005_post drought2006_post drought2007_post droug
> ht2008_post"

. global controls02 "dwell_electricity_02_post dwell_floor_good_02_post dwell_r
> oof_good_02_post dwell_ventilation_good_02_post rooms_per_person_02_post ln_p
> c_expend_month_02_post rural_02_post"

. global controls05 "mother_height_cm_05_post mother_edu_years_05_post mother_a
> ge_at_birth_05_post mother_employed_05_post fully_vaccinated_05_post"

. global controls05_birth "father_height_cm_05_post father_edu_years_05_post fa
> ther_age_at_birth_05_post father_employed_05_post birth_order_05_post oldest_
> child_05_post birth_weight_kg_05_post delivered_home_05_post predominant_brea
> stfed_05_post iron_pregnancy_05_post premature_05_post"

. 
. * Event study controls, the Model 3 controls each interacted with the 2002 an
> d 2009 waves, same as DID_Regs.do except child_male_05 is taken out because s
> ex does not vary within a subsample
. global es_controls ""

. foreach c in drought2005 drought2006 drought2007 drought2008 dwell_electricit
> y_02 dwell_floor_good_02 dwell_roof_good_02 dwell_ventilation_good_02 rooms_p
> er_person_02 ln_pc_expend_month_02 rural_02 mother_height_cm_05 mother_edu_ye
> ars_05 mother_age_at_birth_05 mother_employed_05 fully_vaccinated_05 {
  2.     gen `c'_w02 = `c' * (year == 2002)
  3.     gen `c'_w09 = `c' * (year == 2009)
  4.     global es_controls "$es_controls `c'_w02 `c'_w09"
  5. }
