. *******************************************************************
. * Triple difference by sex, all children
. *******************************************************************
. 
. * Same as Model 5 of DID_Regs.do, but with child sex
. gen treat_post_male05 = treat_post * child_male_05
(25,453 missing values generated)

. label variable treat_post_male05 "2009 drought x post x male"

. foreach v in haz waz bmiz {
  2.     reghdfe `v' treat_post child_male_05_post treat_post_male05 $did_contr
> ols $controls02 $controls05 if s_`v' == 1, absorb($FE_month) vce(cluster cveg
> eo05)
  3.     * Total drought effect for boys
.     lincom treat_post + treat_post_male05
  4.     * Children in this regression, for the event study below
.     gen tmp = e(sample)
  5.     bysort pid_link_canonical: egen mddd_`v' = max(tmp)
  6.     drop tmp
  7. }
