. 
. * reghdfe and its dependencies, same as DID_Regs.do
. capture which reghdfe

. if _rc ssc install reghdfe

. capture which ftools

. if _rc ssc install ftools

. capture which require

. if _rc ssc install require

. 
. *******************************************************************
. * Regressions by sex
. *******************************************************************
. 
. * Everything below runs once for boys and once for girls. 
. * Note that: Figures and event study files get _boys or _girls at the end of 
> the name
. foreach s in boys girls {
  2. if "`s'" == "boys"  local sex "child_male_05 == 1"
  3. if "`s'" == "girls" local sex "child_male_05 == 0"
  4. di as result _n "==================== `s' ===================="
  5. 
. *******************************************************************
. * DID regressions: 2009 drought
. *******************************************************************
. 
. * Now we do the regressions again splitting on sex 
. foreach v in haz waz bmiz {
  6.     * Model 1: Basic DID
.     reghdfe `v' treat_post if s_`v' == 1 & `sex', absorb($FE_month) vce(clust
> er cvegeo05)
  7.     * Model 2: DID controlling for the other droughts in the window
.     reghdfe `v' treat_post $did_controls if s_`v' == 1 & `sex', absorb($FE_mo
> nth) vce(cluster cvegeo05)
  8.     * Model 3: DID with baseline 2002 household controls and 2005 child an
> d mother controls
.     reghdfe `v' treat_post $did_controls $controls02 $controls05 if s_`v' == 
> 1 & `sex', absorb($FE_month) vce(cluster cvegeo05)
  9.         * Model 4: Model 3 with the father and birth controls, smaller sam
> ple
.     reghdfe `v' treat_post $did_controls $controls02 $controls05 $controls05_
> birth if s_`v' == 1 & `sex', absorb($FE_month) vce(cluster cvegeo05)
 10.     * Model 5: Triple difference, does 2002 remittance receipt buffer the 
> drought
.     reghdfe `v' treat_post remittance_hh_02_post treat_post_remit02 $did_cont
> rols $controls02 $controls05 if s_`v' == 1 & `sex', absorb($FE_month) vce(clu
> ster cvegeo05)
 11.     * Total drought effect for children in 2002 remittance households
.     lincom treat_post + treat_post_remit02
 12. }
 13. 
. *******************************************************************
. * Parallel trends and event study
. *******************************************************************
. 
. * Parallel trends graph and event study split on sex
. foreach v in haz waz bmiz {
 14.     preserve
 15.     keep if e_`v' == 1 & `sex'
 16.     collapse (mean) `v', by(treat2009 year)
 17.     twoway ///
>         (connected `v' year if treat2009 == 0, mc(navy) lc(navy) ms(O)) ///
>         (connected `v' year if treat2009 == 1, mc(cranberry) lc(cranberry) ms
> (T)), ///
>         xline(2009, lp(dash) lc(black)) ///
>         xlabel(2002 2005 2009) ///
>         legend(order(1 "Control" 2 "Treated (2009 drought)") pos(6) row(1)) /
> //
>         xtitle("Wave") ytitle("Mean `v'") ///
>         title("Mean `v' by wave, treated vs control, `s'")
 18.     graph export "$out_figs/Online_Appendix/trends_`v'_`s'.png", replace
 19.     restore
 20. }
 21. 
. * Model 3 and Model 5 children of this subsample, so the event studies use th
> e same children as the DID tables, same as DID_Regs.do
. foreach v in haz waz bmiz {
 22.     capture drop m3_`v' m5_`v'
 23.     quietly reghdfe `v' treat_post $did_controls $controls02 $controls05 i
> f s_`v' == 1 & `sex', absorb($FE_month) vce(cluster cvegeo05)
 24.     gen tmp = e(sample)
 25.     bysort pid_link_canonical: egen m3_`v' = max(tmp)
 26.     drop tmp
 27.     quietly reghdfe `v' treat_post remittance_hh_02_post treat_post_remit0
> 2 $did_controls $controls02 $controls05 if s_`v' == 1 & `sex', absorb($FE_mon
> th) vce(cluster cvegeo05)
 28.     gen tmp = e(sample)
 29.     bysort pid_link_canonical: egen m5_`v' = max(tmp)
 30.     drop tmp
 31. }
 32. 
. * Event-study TWFE DID
. foreach v in haz waz bmiz {
 33.     * We restrict to the Model 3 children
.     reghdfe `v' lead_2_treat lag_0_treat if e_`v' == 1 & m3_`v' == 1 & `sex',
>  absorb($FE_month) vce(cluster cvegeo05)
 34.     test lead_2_treat
 35. 
.     preserve
 36.     postfile handle int etime double b se lb ub using "$out_regs/Appendix/
> es_`v'_`s'.dta", replace
 37.     post handle (-2) (_b[lead_2_treat]) (_se[lead_2_treat]) (_b[lead_2_tre
> at] - 1.96*_se[lead_2_treat]) (_b[lead_2_treat] + 1.96*_se[lead_2_treat])
 38.     post handle (-1) (0) (0) (0) (0)
 39.     post handle (0) (_b[lag_0_treat]) (_se[lag_0_treat]) (_b[lag_0_treat] 
> - 1.96*_se[lag_0_treat]) (_b[lag_0_treat] + 1.96*_se[lag_0_treat])
 40.     postclose handle
 41. 
.     use "$out_regs/Appendix/es_`v'_`s'.dta", clear
 42.     sort etime
 43.     twoway ///
>         (rcap ub lb etime, lcolor(black)) ///
>         (scatter b etime, mcolor(blue) msymbol(O)), ///
>         xlabel(-2 "2002" -1 "2005 (ref)" 0 "2009") ///
>         xline(-1, lpattern(dash) lcolor(red)) ///
>         yline(0, lpattern(dash) lcolor(black)) ///
>         xtitle("Event time (wave)") ytitle("Coefficient") ///
>         title("Event study: `v', `s'") legend(off)
 44.     graph export "$out_figs/Online_Appendix/event_study_`v'_`s'.png", repl
> ace
 45.     restore
 46. }
 47. 
. * c. Triple-difference event study
. foreach v in haz waz bmiz {
 48.     * We restrict to the Model 5 children
.     reghdfe `v' lead_2_ddd lag_0_ddd lead_2_treat lag_0_treat lead_2_remit la
> g_0_remit $es_controls if e_`v' == 1 & m5_`v' == 1 & `sex', absorb($FE_month)
>  vce(cluster cvegeo05)
 49.     test lead_2_ddd
 50.     lincom lag_0_treat + lag_0_ddd
 51. 
.     preserve
 52.     postfile handle int etime double b se lb ub using "$out_regs/Appendix/
> es_ddd_`v'_`s'.dta", replace
 53.     post handle (-2) (_b[lead_2_ddd]) (_se[lead_2_ddd]) (_b[lead_2_ddd] - 
> 1.96*_se[lead_2_ddd]) (_b[lead_2_ddd] + 1.96*_se[lead_2_ddd])
 54.     post handle (-1) (0) (0) (0) (0)
 55.     post handle (0) (_b[lag_0_ddd]) (_se[lag_0_ddd]) (_b[lag_0_ddd] - 1.96
> *_se[lag_0_ddd]) (_b[lag_0_ddd] + 1.96*_se[lag_0_ddd])
 56.     postclose handle
 57. 
.     use "$out_regs/Appendix/es_ddd_`v'_`s'.dta", clear
 58.     sort etime
 59.     twoway ///
>         (rcap ub lb etime, lcolor(black)) ///
>         (scatter b etime, mcolor(blue) msymbol(O)), ///
>         xlabel(-2 "2002" -1 "2005 (ref)" 0 "2009") ///
>         xline(-1, lpattern(dash) lcolor(red)) ///
>         yline(0, lpattern(dash) lcolor(black)) ///
>         xtitle("Event time (wave)") ytitle("Coefficient") ///
>         title("DDD event study (drought x 2002 remittances): `v', `s'") legen
> d(off)
 60.     graph export "$out_figs/Online_Appendix/event_study_ddd_`v'_`s'.png", 
> replace
 61.     restore
 62. }
 63. 
. *******************************************************************
. * Robustness tests
. *******************************************************************
. 
. *******************************************************************
. * a. Children measured in all three waves
. *******************************************************************
. 
. foreach v in haz waz bmiz {
 64.     reghdfe `v' treat_post if s_`v' == 1 & e_`v'_all3 == 1 & `sex', absorb
> ($FE_month) vce(cluster cvegeo05)
 65.     reghdfe `v' treat_post $did_controls if s_`v' == 1 & e_`v'_all3 == 1 &
>  `sex', absorb($FE_month) vce(cluster cvegeo05)
 66.     reghdfe `v' treat_post $did_controls $controls02 $controls05 if s_`v' 
> == 1 & e_`v'_all3 == 1 & `sex', absorb($FE_month) vce(cluster cvegeo05)
 67.     reghdfe `v' treat_post $did_controls $controls02 $controls05 $controls
> 05_birth if s_`v' == 1 & e_`v'_all3 == 1 & `sex', absorb($FE_month) vce(clust
> er cvegeo05)
 68.     reghdfe `v' treat_post remittance_hh_02_post treat_post_remit02 $did_c
> ontrols $controls02 $controls05 if s_`v' == 1 & e_`v'_all3 == 1 & `sex', abso
> rb($FE_month) vce(cluster cvegeo05)
 69.     lincom treat_post + treat_post_remit02
 70. }
 71. 
. foreach v in haz waz bmiz {
 72.     preserve
 73.     keep if e_`v'_all3 == 1 & `sex'
 74.     collapse (mean) `v', by(treat2009 year)
 75.     twoway ///
>         (connected `v' year if treat2009 == 0, mc(navy) lc(navy) ms(O)) ///
>         (connected `v' year if treat2009 == 1, mc(cranberry) lc(cranberry) ms
> (T)), ///
>         xline(2009, lp(dash) lc(black)) ///
>         xlabel(2002 2005 2009) ///
>         legend(order(1 "Control" 2 "Treated (2009 drought)") pos(6) row(1)) /
> //
>         xtitle("Wave") ytitle("Mean `v'") ///
>         title("Mean `v' by wave, children in all 3 waves, `s'")
 76.     graph export "$out_figs/Online_Appendix/trends_`v'_all3_`s'.png", repl
> ace
 77.     restore
 78. 
.     reghdfe `v' lead_2_treat lag_0_treat if e_`v'_all3 == 1 & `sex', absorb($
> FE_month) vce(cluster cvegeo05)
 79.     test lead_2_treat
 80. 
.     preserve
 81.     postfile handle int etime double b se lb ub using "$out_regs/Appendix/
> es_`v'_all3_`s'.dta", replace
 82.     post handle (-2) (_b[lead_2_treat]) (_se[lead_2_treat]) (_b[lead_2_tre
> at] - 1.96*_se[lead_2_treat]) (_b[lead_2_treat] + 1.96*_se[lead_2_treat])
 83.     post handle (-1) (0) (0) (0) (0)
 84.     post handle (0) (_b[lag_0_treat]) (_se[lag_0_treat]) (_b[lag_0_treat] 
> - 1.96*_se[lag_0_treat]) (_b[lag_0_treat] + 1.96*_se[lag_0_treat])
 85.     postclose handle
 86. 
.     use "$out_regs/Appendix/es_`v'_all3_`s'.dta", clear
 87.     sort etime
 88.     twoway ///
>         (rcap ub lb etime, lcolor(black)) ///
>         (scatter b etime, mcolor(blue) msymbol(O)), ///
>         xlabel(-2 "2002" -1 "2005 (ref)" 0 "2009") ///
>         xline(-1, lpattern(dash) lcolor(red)) ///
>         yline(0, lpattern(dash) lcolor(black)) ///
>         xtitle("Event time (wave)") ytitle("Coefficient") ///
>         title("Event study, children in all 3 waves: `v', `s'") legend(off)
 89.     graph export "$out_figs/Online_Appendix/event_study_`v'_all3_`s'.png",
>  replace
 90.     restore
 91. }
 92. }

